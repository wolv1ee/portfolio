---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';

// ✏️ EDIT: Add your real blog posts here.
// href can be an external link (Medium, dev.to, Hashnode) or an internal route like /blog/post-slug
const posts = [
  // { date: 'May 2026', title: 'Post title', excerpt: 'One line summary.', href: '/blog/post-slug' },
];
---

<Layout title="Blog">
  <section class="section" style="padding-top: 10rem;">
    <div class="section-label">Writing</div>
    <h2>Blog.</h2>
    <p class="section-sub">What I've been up to lately</p>

    {posts.length > 0 ? (
      <div class="blog-list">
        {posts.map((post, i) => (
          <a
            href={post.href}
            class={`blog-item reveal ${i > 0 ? `reveal-delay-${Math.min(i, 3)}` : ''}`}
            target={post.href.startsWith('http') ? '_blank' : '_self'}
            rel="noopener noreferrer"
          >
            <div class="blog-date">{post.date}</div>
            <div class="blog-body">
              <div class="blog-title">{post.title}</div>
              <div class="blog-excerpt">{post.excerpt}</div>
            </div>
            <div class="blog-tag">{post.tag}</div>
          </a>
        ))}
      </div>
    ) : (
      <div class="blog-empty reveal">
        <div class="blog-empty-line"><span class="t-prompt">$ </span>ls ~/blog</div>
        <div class="blog-empty-line t-output">total 0</div>
        <div class="blog-empty-line t-output">first entry loading soon<span class="boot-cursor"></span></div>
      </div>
    )}
  </section>
</Layout>
