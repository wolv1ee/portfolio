---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <div id="boot-overlay" aria-hidden="true">
    <div class="boot-lines" id="bootLines"></div>
  </div>
  <script is:inline>
    (function () {
      var overlay = document.getElementById('boot-overlay');
      if (!overlay) return;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || sessionStorage.getItem('booted')) overlay.style.display = 'none';
    })();
  </script>
  <section id="hero">
  <div class="hero-left">
    <h1>
      Building <em>secure</em>
      digital experiences<span class="dots"><span>.</span><span>.</span><span>.</span></span>
    </h1>
    <p class="hero-sub">
      Developer & cybersecurity enthusiast. <br />
      Computer Information Systems at Western Michigan University.
    </p>
    <p class="hero-role"><span class="t-prompt">&gt;</span><span id="roleText"></span><span class="boot-cursor"></span></p>
    <div class="hero-cta">
      <a href="/projects" class="btn btn-primary">[ View Projects ]</a>
      <a href="/contact" class="btn btn-ghost">[ Get in Touch ]</a>
    </div>
  </div>
  <div class="terminal-col">
    <div class="terminal">
      <div class="terminal-bar">
        <span class="t-dot" style="background:#ff5f57"></span>
        <span class="t-dot" style="background:#febc2e"></span>
        <span class="t-dot" style="background:#28c840"></span>
        <span class="t-title">saad@portfolio ~ </span>
      </div>
      <div class="terminal-body" id="termBody"></div>
      <div class="terminal-input-row">
        <span class="t-prompt">$ </span>
        <input type="text" id="termInput" placeholder="type a command..." autocomplete="off" spellcheck="false" />
      </div>
    </div>
    <div class="terminal-links">
      <a href="https://github.com/wolv1ee" target="_blank" class="terminal-link">
        <span class="t-link-icon">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </span>
        GitHub ↗
      </a>
      <a href="https://linkedin.com/in/saad-mahmud-" target="_blank" class="terminal-link">
        <span class="t-link-icon">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </span>
        LinkedIn ↗
      </a>
    </div>
  </div>
</section>

<section id="about" class="section" style="padding-top: 3rem;">
  <div class="section-label">About me</div>
  <div class="about-grid">
    <div class="reveal">
      <div class="about-img-wrap">
        <img src="/images/saad.webp" alt="Saad Mahmud" loading="eager" decoding="async" fetchpriority="high" width="1000" height="1214" style="width:100%;height:100%;object-fit:cover;object-position:center top;" />
      </div>
    </div>
    <div class="about-text">
      <h2 class="reveal"><em>Developer.</em><br />Security-minded.</h2>
      <div class="cmd-line reveal reveal-delay-1"><span class="t-prompt">$</span> cat about.me</div>
      <p class="reveal reveal-delay-1">
        I'm studying CIS & Cybersecurity at Western Michigan University,
        with hands-on experience as an IT Technician at WMU's College of Arts and Science Technology Services.
        Outside of academics, I'm involved with <span class="text-accent">WRAVEN</span> (OSINT Team), the
        <span class="text-accent">Developers Club</span> (Systems Team), and the
        <span class="text-accent">Data Science & AI Club</span> (Vice President).
      </p>
      <p class="reveal reveal-delay-2">
        I have both technical and administrative experience which made me adaptable to new challenges and a fast learner.
        Out of work I'm a regular gamer who loves MMORPGs the most, currently obsessed with Path of Exile 2!
      </p>
      <div class="skills-list reveal reveal-delay-3">
        <span class="skill-tag">Python</span>
        <span class="skill-tag">JavaScript</span>
        <span class="skill-tag">React</span>
        <span class="skill-tag">Astro</span>
        <span class="skill-tag">System & Network Admin</span>
        <span class="skill-tag">Linux</span>
        <span class="skill-tag">CSS</span>
        <span class="skill-tag">Active Directory</span>
        <span class="skill-tag">Mosyle</span>
        <span class="skill-tag">Intune</span>
      </div>
    </div>
  </div>
</section>

<section id="certifications" class="section" style="padding-top:0; padding-bottom:2rem;">
  <div class="section-label">Certifications</div>
  <h2>Credentials.</h2>
  <div class="certs-grid reveal">
    <a href="https://www.credly.com/earner/earned/badge/6023f9f4-c4f0-4793-984a-ace59daaa737" target="_blank" class="cert-card">
      <div class="cert-status"><span class="cert-status-dot"></span>Active</div>
      <img src="/images/security-plus.webp" alt="CompTIA Security+" class="cert-icon-img" loading="lazy" decoding="async" />
      <div class="cert-body">
        <div class="cert-name">CompTIA Security+</div>
        <div class="cert-issuer">CompTIA · 2026</div>
      </div>
    </a>
    <a href="https://www.credly.com/badges/8b55849e-bb8f-41f3-9967-d2d98d60593d/public_url" target="_blank" class="cert-card">
      <div class="cert-status"><span class="cert-status-dot"></span>Active</div>
      <img src="/images/isc2-cc.webp" alt="ISC2 CC" class="cert-icon-img" loading="lazy" decoding="async" />
      <div class="cert-body">
        <div class="cert-name">Certified in Cybersecurity (CC)</div>
        <div class="cert-issuer">ISC2 · 2026</div>
      </div>
    </a>
  </div>
</section>

<section id="experience" class="section" style="padding-top:0;">
  <div class="section-label">Experience</div>
  <h2>Work History.</h2>
  <div class="exp-list reveal">
    <div class="exp-item">
      <div class="exp-left">
        <div class="exp-date">Sep 2026 – Present</div>
        <a href="https://kalamazoohousingadvocates.org/" target="_blank">
        <img src="/images/kha-logo.webp" alt="Kalamazoo Housing Advocates" class="exp-logo" loading="lazy" decoding="async" />
      </a>
      </div>
      <div class="exp-right">
        <div class="exp-title">Development Intern</div>
        <div class="exp-company">Kalamazoo Housing Advocates</div>
        <ul class="exp-bullets">
          <li>Improve different systems and find ways to automate.</li>
          <li>Research and apply to grant funds and increase budget.</li>
          <li>Analyze data and find ways to optimize budget.</li>
        </ul>
      </div>
    </div>
    <div class="exp-item">
      <div class="exp-left">
        <div class="exp-date">Apr 2026 – Present</div>
        <a href="https://wmich.edu/arts-sciences/technology" target="_blank">
          <img src="/images/WMU.svg" alt="WMU" class="exp-logo" loading="lazy" decoding="async" />
        </a>
      </div>
      <div class="exp-right">
        <div class="exp-title">IT Technician</div>
        <div class="exp-company">WMU College of Arts and Science Technology Services</div>
        <ul class="exp-bullets">
          <li>Manage user accounts, permissions, and device policies using Active Directory and Mosyle MDM.</li>
          <li>Resolve hardware, software, printer, and network issues via Salesforce service tickets.</li>
          <li>Support and troubleshoot Windows and macOS systems for faculty, staff, and students.</li>
        </ul>
      </div>
    </div>
    <div class="exp-item">
      <div class="exp-left">
        <div class="exp-date">Apr 2026 – Present</div>
        <a href="https://wmich.edu/career" target="_blank">
          <img src="/images/WMU.svg" alt="WMU" class="exp-logo" loading="lazy" decoding="async" />
        </a>
      </div>
      <div class="exp-right">
        <div class="exp-title">Employment Report Assistant</div>
        <div class="exp-company">WMU Career and Employment Services</div>
        <ul class="exp-bullets">
          <li>Analyze student employment data from PeopleSoft, Handshake, and Banner for reporting.</li>
          <li>Build and maintain the Annual Student Employment Report using Excel.</li>
          <li>Process confidential employment verifications via email, MS Teams, and phone.</li>
        </ul>
      </div>
    </div>
    <div class="exp-item">
      <div class="exp-left">
        <div class="exp-date">Apr 2025 – Apr 2026</div>
        <a href="https://wmich.edu/student-center" target="_blank">
          <img src="/images/WMU.svg" alt="WMU" class="exp-logo" loading="lazy" decoding="async" />
        </a>
      </div>
      <div class="exp-right">
        <div class="exp-title">Student Facility Manager</div>
        <div class="exp-company">WMU Student Center</div>
        <ul class="exp-bullets">
          <li>Configured and troubleshot 8 high-end gaming PCs for semester-long use.</li>
          <li>Managed AV/IT systems for 50+ campus events annually, reducing event downtime.</li>
          <li>Led help desk student staff to deliver reliable guest support experiences.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="projects" class="section" style="padding-top:0;">
  <div class="section-label">Featured Work</div>
  <h2>Recent Projects.</h2>
  <p class="section-sub">A few things I made recently.</p>
  <div class="projects-grid-home reveal">
        <a href="https://threatlens-eight.vercel.app/" class="project-card-home" target="_blank">
      <div class="project-content">
        <div class="project-num">Featured</div>
        <h3 class="project-title">Malware Analysis Web App</h3>
        <p class="project-desc">
          A file security tool that computes the hash of a downloaded file and 
          cross-references it against known malware databases, warning the user 
          if anything suspicious is detected.
        </p>
        <div class="project-tags">
          <span class="project-tag">Next.js</span>
          <span class="project-tag">Tailwind CSS</span>
          <span class="project-tag">Supabase</span>
          <span class="project-tag">Google Safe Browsing API</span>
          <span class="project-tag">VirusTotal API</span>
        </div>
      </div>
      <div class="project-img-wrap">
        <img
          src="/images/Threatlens-768w.webp"
          srcset="/images/Threatlens-768w.webp 768w, /images/Threatlens-1200w.webp 1200w, /images/Threatlens.webp 2940w"
          sizes="(max-width: 768px) 100vw, 720px"
          alt="ThreatLens"
          loading="lazy"
          decoding="async"
          style="width:100%;height:100%;object-fit:cover;"
        />
      </div>
      <span class="project-arrow">↗</span>
    </a>
  </div>
  <div style="margin-top:2rem;">
    <a href="/projects" class="btn btn-ghost">[ All Projects ]</a>
  </div>
</section>

</Layout>


<script>
  import gsap from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const overlay = document.getElementById('boot-overlay');
  const bootLines = document.getElementById('bootLines');
  const termBody = document.getElementById('termBody');
  const h1 = document.querySelector('h1');

  const bootMessages = [
    'SAAD_OS v2.6 // BOOT SEQUENCE',
    'LOADING KERNEL... OK',
    'MOUNTING /home/saad... OK',
    'STARTING SERVICES: web · security · curiosity... OK',
    'PRESS START',
  ];

  const termLines = [
    { type: 'cmd', text: 'whoami' },
    { type: 'out', text: 'saad - developer & security enthusiast' },
    { type: 'cmd', text: 'status' },
    { type: 'out', text: 'open to internships' },
    { type: 'cmd', text: "type 'help' for commands_" },
  ];

  function typeTerminal(instant) {
    if (!termBody) return;
    termBody.innerHTML = '';
    let idx = 0;
    function renderLine() {
      if (idx >= termLines.length) return;
      const line = termLines[idx];
      const div = document.createElement('div');
      div.className = line.type === 'cmd' ? 't-line' : 't-line t-output';
      if (instant) {
        div.innerHTML = line.type === 'cmd'
          ? `<span class="t-prompt">$ </span><span class="t-cmd">${line.text}</span>`
          : line.text;
        termBody.appendChild(div);
        idx++;
        renderLine();
        return;
      }
      if (line.type === 'cmd') {
        div.innerHTML = '<span class="t-prompt">$ </span><span class="t-cmd"></span>';
        termBody.appendChild(div);
        const cmdSpan = div.querySelector('.t-cmd');
        let c = 0;
        const typer = setInterval(() => {
          cmdSpan.textContent += line.text[c];
          c++;
          if (c >= line.text.length) {
            clearInterval(typer);
            idx++;
            setTimeout(renderLine, 180);
          }
        }, 28);
      } else {
        div.textContent = line.text;
        termBody.appendChild(div);
        idx++;
        setTimeout(renderLine, 220);
      }
    }
    renderLine();
  }

  const roles = ['IT Technician', 'Web Developer', 'Systems Enthusiast', 'Cybersecurity Enthusiast'];

  function typeRoleLoop() {
    const el = document.getElementById('roleText');
    if (!el) return;
    if (reducedMotion) { el.textContent = roles[0]; return; }
    let roleIdx = 0;
    let charIdx = 0;
    let deleting = false;
    function tick() {
      const current = roles[roleIdx];
      if (!deleting) {
        charIdx++;
        el.textContent = current.slice(0, charIdx);
        if (charIdx === current.length) {
          deleting = true;
          setTimeout(tick, 1500);
          return;
        }
      } else {
        charIdx--;
        el.textContent = current.slice(0, charIdx);
        if (charIdx === 0) {
          deleting = false;
          roleIdx = (roleIdx + 1) % roles.length;
        }
      }
      setTimeout(tick, deleting ? 28 : 55);
    }
    tick();
  }

  function playHeroEntrance() {
    if (reducedMotion) return;
    gsap.from('.hero-sub', { y: 20, opacity: 0, duration: 0.8, delay: 0.3 });
    gsap.from('.hero-role', { y: 20, opacity: 0, duration: 0.8, delay: 0.45 });
    gsap.from('.hero-cta', { y: 20, opacity: 0, duration: 0.8, delay: 0.6 });
    gsap.from('.terminal-col', { x: 20, opacity: 0, duration: 1, delay: 0.2, ease: 'power3.out' });
  }

  const alreadyBooted = sessionStorage.getItem('booted');

  if (overlay && !reducedMotion && !alreadyBooted) {
    let i = 0;
    function nextBootLine() {
      if (i < bootMessages.length) {
        const p = document.createElement('div');
        p.textContent = bootMessages[i];
        bootLines?.appendChild(p);
        i++;
        setTimeout(nextBootLine, i === bootMessages.length ? 500 : 240);
      } else {
        powerOn();
      }
    }
    function powerOn() {
      overlay.classList.add('power-off');
      h1?.classList.add('glitch-in');
      playHeroEntrance();
      typeTerminal(false);
      typeRoleLoop();
      setTimeout(() => {
        overlay.style.display = 'none';
        sessionStorage.setItem('booted', '1');
      }, 600);
    }
    nextBootLine();
  } else {
    if (overlay) overlay.style.display = 'none';
    playHeroEntrance();
    typeTerminal(reducedMotion);
    typeRoleLoop();
  }

  const commands = {
    help: 'Available: help, about, skills, contact, sudo, coffee, matrix, clear',
    about: 'Saad Mahmud - Dev & Cybersecurity @WMU | IT Technician @CASTS',
    skills: 'Python · JS · React · Astro · Linux · Network & System Admin',
    contact: 'Refer to the contact page!',
    sudo: 'nice try. permission denied.',
    coffee: 'brewing... ready.',
    clear: '__clear__',
  };

  const termInput = document.getElementById('termInput');
  const terminalEl = document.querySelector('.terminal');

  termInput?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const val = termInput.value.trim().toLowerCase();
    termInput.value = '';
    const inputLine = document.createElement('div');
    inputLine.className = 't-line';
    inputLine.innerHTML = `<span class="t-prompt">$ </span><span class="t-cmd">${val}</span>`;
    termBody.appendChild(inputLine);

    if (val === 'matrix') {
      const outputLine = document.createElement('div');
      outputLine.className = 't-line t-output';
      outputLine.textContent = 'wake up, saad...';
      termBody.appendChild(outputLine);
      terminalEl?.classList.add('matrix-mode');
      setTimeout(() => terminalEl?.classList.remove('matrix-mode'), 2200);
      termBody.scrollTop = termBody.scrollHeight;
      return;
    }

    const response = commands[val] || `command not found: ${val}. Try 'help'`;
    if (response === '__clear__') {
      termBody.innerHTML = '';
    } else {
      const outputLine = document.createElement('div');
      outputLine.className = 't-line t-output';
      outputLine.textContent = response;
      termBody.appendChild(outputLine);
    }
    termBody.scrollTop = termBody.scrollHeight;
  });
</script>