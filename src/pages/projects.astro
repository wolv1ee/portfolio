---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'WMU Student Employment Annual Report 2025-26',
    desc: "Co-authored WMU's official annual report on 2,248 student employees in 3,385 positions, analyzing employment rate, concurrent jobs, and average wages ($15.30 per student) by domestic and international status.",
    tags: ['SQL', 'Microsoft Excel', 'PeopleSoft', 'Handshake', 'Banner', 'Data Analysis'],
    href: 'https://files.wmich.edu/s3fs-public/2026-08/wmu_student_employment_annual_report_2025-26.docx',
    image: '/images/wmu-report.webp',
  },
  {
    title: 'ThreatLens: Malware Analysis Web App',
    desc: 'A full-stack cybersecurity platform that analyzes files and URLs in real time, integrating the VirusTotal and Google Safe Browsing APIs for threat detection.',
    tags: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase', 'VirusTotal API', 'Google Safe Browsing API'],
    href: 'https://threatlens-eight.vercel.app/',
    image: '/images/Threatlens.webp',
  },
  {
    title: 'Active Directory Home Lab',
    desc: 'Built a Windows Server Active Directory domain in VMware, creating users and groups, implementing Group Policy Objects, and automating administrative tasks with PowerShell.',
    tags: ['Windows Server', 'Active Directory', 'VMware', 'Group Policy', 'PowerShell', 'Kerberos'],
    href: 'https://www.linkedin.com/feed/update/urn:li:activity:7447074994968248321/',
    image: '/images/ActiveD.webp',
  },
  {
    title: 'AI Inference Server',
    desc: 'Leading the build of a self-hosted AI inference server running containerized vLLM with an OpenAI-compatible API, for the Data Science and AI Club.',
    tags: ['vLLM', 'Docker', 'Linux', 'OpenAI-compatible API', 'Self-hosted', 'In Progress'],
    href: 'https://github.com/Data-Science-Club-at-WMU/ai-interference-server',
  },
];
---

<Layout title="Projects">
  <section class="section" style="padding-top: 6rem;">
    <div class="section-label">Work</div>
    <h2>All Projects.</h2>
    <p class="section-sub">Things I've built: from cybersecurity tools to web apps.</p>
    <div class="cmd-line"><span class="t-prompt">$</span> ls ~/projects<br />total {projects.length}</div>
    <div class="projects-grid-full">
      {projects.map((p, i) => (
        <a
          href={p.href}
          class={`project-card-full reveal ${i > 0 ? `reveal-delay-${Math.min(i, 3)}` : ''}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="project-arrow">↗</span>
          {p.image ? (
            <div class="project-img">
              <img
                src={p.image === '/images/Threatlens.webp' ? '/images/Threatlens-768w.webp' : p.image}
                srcset={p.image === '/images/Threatlens.webp' ? '/images/Threatlens-768w.webp 768w, /images/Threatlens-1200w.webp 1200w, /images/Threatlens.webp 2940w' : p.image}
                sizes="(max-width: 768px) 100vw, 720px"
                alt={p.title}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="project-img project-img--empty">
              <span class="font-mono text-sm tracking-wide">Coming Soon</span>
            </div>
          )}
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.desc}</p>
          <div class="project-tags">
            {p.tags.map(tag => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>