---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Active Directory Home Lab',
    desc: 'Built a test environment Active Directory lab on Windows Server 2022 from scratch. Covered DC promotion, DNS, DHCP, OUs, GPOs, Kerberos authentication, and security policies including account lockout, complexity requirements, and audit logging.',
    tags: ['Windows Server 2022', 'Active Directory', 'DNS', 'DHCP', 'Kerberos', 'GPO'],
    href: 'https://www.linkedin.com/feed/update/urn:li:activity:7447074994968248321/',
    image: '/images/ActiveD.webp',
  },
  {
    title: 'Threatlens Web App',
    desc: 'A file security tool that computes the hash of a downloaded file and\n            cross-references it against known malware databases, warning the user\n            if anything suspicious is detected.',
    tags: ['next.js', 'Tailwind CSS', 'VirusTotal API', 'Google Safe Browsing API', 'Supabase'],
    href: 'https://threatlens-eight.vercel.app/',
    image: '/images/Threatlens.webp',
  },
];
---

<Layout title="Projects">
  <section class="section" style="padding-top: 6rem;">
    <div class="section-label">Work</div>
    <h2>All Projects.</h2>
    <p class="section-sub">Things I've built: from cybersecurity tools to web apps.</p>
    <div class="cmd-line"><span class="t-prompt">$</span> ls ~/projects<br />total {projects.length}</div>
    <div class="projects-grid-full">
      {projects.map((p, i) => (
        <a
          href={p.href}
          class={`project-card-full reveal ${i > 0 ? `reveal-delay-${Math.min(i, 3)}` : ''}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="project-arrow">↗</span>
          {p.image ? (
            <div class="project-img">
              <img
                src={p.image === '/images/Threatlens.webp' ? '/images/Threatlens-768w.webp' : p.image}
                srcset={p.image === '/images/Threatlens.webp' ? '/images/Threatlens-768w.webp 768w, /images/Threatlens-1200w.webp 1200w, /images/Threatlens.webp 2940w' : p.image}
                sizes="(max-width: 768px) 100vw, 720px"
                alt={p.title}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="project-img project-img--empty">
              <span>📸</span>
            </div>
          )}
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.desc}</p>
          <div class="project-tags">
            {p.tags.map(tag => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>